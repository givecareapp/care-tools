{
  "name": "@givecare/tools",
  "version": "2.0.0",
  "description": "Open-source caregiving domain logic: SDOH assessments, composite scoring, benefits screening, SMS journey state machine, risk classification, and geo utilities",
  "license": "MIT",
  "author": "Ali Madad <ali@scty.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/givecareapp/care-tools"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./assessments": {
      "import": "./dist/assessments/instruments.js",
      "types": "./dist/assessments/instruments.d.ts"
    },
    "./scoring": {
      "import": "./dist/scoring/givecareScore.js",
      "types": "./dist/scoring/givecareScore.d.ts"
    },
    "./benefits": {
      "import": "./dist/benefits/screener.js",
      "types": "./dist/benefits/screener.d.ts"
    },
    "./sms": {
      "import": "./dist/sms/classification.js",
      "types": "./dist/sms/classification.d.ts"
    },
    "./transitions": {
      "import": "./dist/transitions.js",
      "types": "./dist/transitions.d.ts"
    },
    "./geo": {
      "import": "./dist/geo/timezone.js",
      "types": "./dist/geo/timezone.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
